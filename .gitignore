# Private operational data and derived evidence
/private/
/metrics.json

# Third-party handwriting corpus (downloaded locally, never published)
/datasets/bressay/
/datasets/bressay.zip

# Reproducible generated datasets
/data/synthetic/*
!/data/synthetic/.gitkeep

# Local SQLite state
/data/*.db
/data/*.db-journal
/data/*.db-shm
/data/*.db-wal

# Exact local Python environment and tool caches
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.coverage
/htmlcov/
**/__pycache__/
*.py[codz]

# Local packaging output
/build/
/dist/
/*.egg-info/

# Local secrets and machine-specific editor settings
/.env
/.envrc
/.claude/settings.local.json
/.idea/
/.vscode/

# Operating-system noise
.DS_Store
Thumbs.db
